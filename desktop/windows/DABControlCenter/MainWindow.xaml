<Window x:Class="DABControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DAB Control Center"
        Width="1180"
        Height="760"
        MinWidth="940"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="DAB Control Center"
                           FontSize="30"
                           FontWeight="Bold"/>
                <TextBlock Text="DAB Control Suite"
                           Foreground="{StaticResource GoldBrush}"
                           FontSize="15"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="ServerAddressTextBox"
                         Text="http://dabserver:8088"
                         VerticalContentAlignment="Center"/>

                <Button Grid.Column="2"
                        Content="Connect"
                        Click="ConnectButton_Click"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}"
                    CornerRadius="22"
                    Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="StationNameTextBlock"
                                   Text="No station selected"
                                   FontSize="30"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="RadiotextTextBlock"
                                   Text="Connect to a DAB Control Server"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="17"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="2"
                            Background="{StaticResource PanelAltBrush}"
                            CornerRadius="18">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="DAB"
                                           Foreground="{StaticResource GoldBrush}"
                                           FontWeight="Bold"
                                           FontSize="56"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="CONTROL"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="16"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="ConnectionIndicator"
                                Width="12"
                                Height="12"
                                CornerRadius="6"
                                Background="{StaticResource DangerBrush}"
                                VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="2"
                                   x:Name="ConnectionTextBlock"
                                   Text="Disconnected"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="22"
                    Padding="24">
                <StackPanel>
                    <TextBlock Text="Reception"
                               FontSize="21"
                               FontWeight="Bold"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Ensemble"
                               Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="EnsembleTextBlock"
                               Text="—"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Margin="0,3,0,16"/>

                    <TextBlock Text="Frequency"
                               Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="FrequencyTextBlock"
                               Text="—"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Margin="0,3,0,22"/>

                    <TextBlock Text="RSSI"
                               Foreground="{StaticResource MutedTextBrush}"/>
                    <ProgressBar x:Name="RssiProgressBar"
                                 Minimum="0"
                                 Maximum="100"
                                 Height="11"
                                 Margin="0,6,0,4"/>
                    <TextBlock x:Name="RssiTextBlock"
                               Text="0"
                               HorizontalAlignment="Right"
                               Margin="0,0,0,14"/>

                    <TextBlock Text="SNR"
                               Foreground="{StaticResource MutedTextBrush}"/>
                    <ProgressBar x:Name="SnrProgressBar"
                                 Minimum="0"
                                 Maximum="30"
                                 Height="11"
                                 Margin="0,6,0,4"/>
                    <TextBlock x:Name="SnrTextBlock"
                               Text="0"
                               HorizontalAlignment="Right"
                               Margin="0,0,0,14"/>

                    <TextBlock Text="FIC quality"
                               Foreground="{StaticResource MutedTextBrush}"/>
                    <ProgressBar x:Name="FicProgressBar"
                                 Minimum="0"
                                 Maximum="100"
                                 Height="11"
                                 Margin="0,6,0,4"/>
                    <TextBlock x:Name="FicTextBlock"
                               Text="0 %"
                               HorizontalAlignment="Right"
                               Margin="0,0,0,18"/>

                    <Border Background="{StaticResource PanelAltBrush}"
                            CornerRadius="12"
                            Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Audio stream"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock Grid.Column="1"
                                       x:Name="StreamStatusTextBlock"
                                       Text="Offline"
                                       Foreground="{StaticResource DangerBrush}"
                                       FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="LastUpdateTextBlock"
                       Text="Not connected"
                       Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                       Text="Prototype 0.1"
                       Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>

:root {
    --gold:#ffd34d;
    --gold2:#ffe27a;
    --bg:#070707;
    --card:rgba(20,20,20,.86);
    --line:rgba(255,211,77,.28);
}
* { box-sizing:border-box; }
body {
    margin:0; min-height:100vh;
    background: radial-gradient(circle at top, #292929 0%, #070707 70%);
    color:var(--gold);
    font-family: Arial, Helvetica, sans-serif;
}
.wrap { max-width:1180px; margin:0 auto; padding:34px 18px; }
.card {
    background:var(--card);
    border:1px solid var(--line);
    border-radius:24px;
    box-shadow:0 0 38px rgba(0,0,0,.7);
    padding:26px;
}
h1 { text-align:center; font-size:42px; margin:6px 0 4px; }
.sub { text-align:center; color:#fff3b0; margin-bottom:22px; }
.dashboard {
    display:grid;
    grid-template-columns: 1fr 1fr;
    gap:18px;
    margin:18px 0 22px;
}
.panel {
    border:1px solid var(--line);
    border-radius:18px;
    background:rgba(0,0,0,.28);
    padding:18px;
}
.now { font-size:28px; color:#fff; margin-bottom:14px; font-weight:bold; }
.text { font-size:20px; color:#fff3b0; min-height:54px; line-height:1.35; }
.logoBox {
    width:150px;
    height:90px;
    border:1px solid var(--line);
    border-radius:16px;
    display:flex;
    align-items:center;
    justify-content:center;
    margin-bottom:16px;
    background:rgba(255,255,255,.06);
}
.logoBox img {
    max-width:135px;
    max-height:75px;
}
#logoFallback {
    font-size:42px;
}
.small { color:#ddd; font-size:14px; margin-top:8px; }
.metric { margin:12px 0; }
.metric-row { display:flex; justify-content:space-between; color:#fff; margin-bottom:5px; }
.bar {
    height:13px;
    border-radius:999px;
    background:#333;
    overflow:hidden;
}
.fill {
    height:100%;
    width:0%;
    background:linear-gradient(90deg, #8a6b00, var(--gold));
    transition:width .4s ease;
}
.badge {
    display:inline-block;
    border:1px solid var(--line);
    border-radius:999px;
    padding:7px 12px;
    margin:4px;
    color:#fff3b0;
    background:rgba(0,0,0,.25);
}
audio { width:100%; margin:8px 0 22px; }
.toolbar { display:flex; justify-content:center; gap:12px; flex-wrap:wrap; margin:8px 0 22px; }
.grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:12px; margin-top:18px; }
button {
    background:var(--gold);
    color:#111;
    border:0;
    border-radius:13px;
    padding:13px 15px;
    font-weight:bold;
    cursor:pointer;
    font-size:15px;
    box-shadow:0 4px 12px rgba(0,0,0,.35);
}
button:hover { background:var(--gold2); }
button.secondary { background:#333; color:var(--gold); border:1px solid var(--line); }
button.secondary:hover { background:#444; }
button.active { outline:3px solid rgba(255,255,255,.45); background:#fff1a6; }
.footer { text-align:center; color:#aaa; margin-top:25px; font-size:13px; }
@media (max-width:800px) {
    .dashboard { grid-template-columns:1fr; }
    h1 { font-size:34px; }
    .now { font-size:24px; }
}

/* Phase 3.1 - Großes Senderlogo */
.logoBox {
    width: 260px;
    height: 135px;
    margin: 0 auto 22px auto;
}

.logoBox img {
    max-width: 240px;
    max-height: 115px;
}

#logoFallback {
    font-size: 58px;
}

.panel:first-child {
    text-align: center;
}

.panel:first-child .now {
    font-size: 32px;
    margin-top: 10px;
}

.panel:first-child .text {
    font-size: 22px;
    margin-top: 12px;
}
